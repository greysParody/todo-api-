# --- Supabase Postgres ---
# Supabase dashboard -> Connect -> "Session pooler" (port 5432, works on IPv4).
# Replace [YOUR-PASSWORD] with your database password. URL-encode special characters.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?connect_timeout=30"
# Used by `prisma migrate`. The session pooler URL above works for both.
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?connect_timeout=30"

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# --- Resend ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# onboarding@resend.dev only delivers to your own Resend account email.
# Verify a domain in Resend to send to anyone.
EMAIL_FROM="Tasks <onboarding@resend.dev>"

# The frontend URL, used to build links in emails.
APP_URL=http://localhost:3000

# Protects POST /api/v1/jobs/reminders. Generate a random secret of at least 32 characters.
REMINDER_JOB_SECRET=

# true only for local runs and CI (lets `npm run contract` read tokens). Never in production.
ENABLE_TEST_ROUTES=false
# true only while iterating locally / in CI.
RATE_LIMIT_DISABLED=false
LOG_LEVEL=info
