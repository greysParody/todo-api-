generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Declaration order matters: Postgres sorts enums in this order,
// so ORDER BY priority DESC gives high, medium, low. Don't reorder.
enum Priority {
  low
  medium
  high
}

enum TokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

enum ReminderPreference {
  none
  at_due
  thirty_minutes_before
  both
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  name            String    @db.VarChar(60)
  email           String    @unique @db.VarChar(254)
  passwordHash    String    @map("password_hash")
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  todos              Todo[]
  refreshTokens      RefreshToken[]
  verificationTokens VerificationToken[]

  @@map("users")
}

model Todo {
  id                 String             @id @default(uuid()) @db.Uuid
  userId             String             @map("user_id") @db.Uuid
  title              String             @db.VarChar(200)
  description        String?
  priority           Priority           @default(medium)
  dueDate            DateTime?          @map("due_date") @db.Date
  dueTime            String?            @map("due_time") @db.VarChar(5)
  dueTimezone        String?            @map("due_timezone") @db.VarChar(64)
  dueAt              DateTime?          @map("due_at") @db.Timestamptz(3)
  reminderPreference ReminderPreference @default(none) @map("reminder_preference")
  reminder30mSentAt  DateTime?          @map("reminder_30m_sent_at") @db.Timestamptz(3)
  reminderDueSentAt  DateTime?          @map("reminder_due_sent_at") @db.Timestamptz(3)
  completed          Boolean            @default(false)
  completedAt        DateTime?          @map("completed_at") @db.Timestamptz(3)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, completed])
  @@index([userId, dueDate])
  @@index([userId, createdAt])
  @@index([dueAt, completed])
  @@map("todos")
}

model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash") @db.Char(64)
  familyId     String    @map("family_id") @db.Uuid
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedById String?   @map("replaced_by_id") @db.Uuid
  userAgent    String?   @map("user_agent")
  ip           String?
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model VerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      TokenType
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("verification_tokens")
}

model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime @map("reset_at") @db.Timestamptz(3)

  @@map("rate_limits")
}
